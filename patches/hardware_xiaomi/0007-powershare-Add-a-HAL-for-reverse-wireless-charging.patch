 aidl/powershare/service.cpp                   | 25 ++++++++
 ...endor.lineage.powershare-service.xiaomi.rc |  7 +++
 ...ndor.lineage.powershare-service.xiaomi.xml |  7 +++
 6 files changed, 149 insertions(+)
 create mode 100644 aidl/powershare/Android.bp
 create mode 100644 aidl/powershare/PowerShare.cpp
 create mode 100644 aidl/powershare/PowerShare.h
