From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iscle <albertiscle9@gmail.com>
Date: Thu, 12 Nov 2026 00:13:03 +0100
Subject: [PATCH 03/10] fingerprint: Open the last opened module first

Opening a module powers up and initializes its sensor even when another
one is fitted, which on some modules leaves pins and services behind.
Start with the module that was opened last time, which is recorded in
persist.vendor.sys.fp.vendor.

Change-Id: I06d22402f5ff1bffb2a441291fc6c1a104474897
---
 aidl/fingerprint/Fingerprint.cpp | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/aidl/fingerprint/Fingerprint.cpp b/aidl/fingerprint/Fingerprint.cpp
index f088fda..a4b9bfe 100644
--- a/aidl/fingerprint/Fingerprint.cpp
+++ b/aidl/fingerprint/Fingerprint.cpp
@@ -15,6 +15,10 @@
 #include <android-base/properties.h>
 #include <android-base/strings.h>
 
+#include <algorithm>
+#include <vector>
+
+using ::android::base::GetProperty;
 using ::android::base::SetProperty;
 
 namespace aidl::android::hardware::biometrics::fingerprint {
@@ -49,7 +53,18 @@ Fingerprint::Fingerprint(std::shared_ptr<FingerprintConfig> config) : mConfig(st
     if (mDevice) {
         ALOGI("fingerprint HAL already opened");
     } else {
-        for (auto& [module] : kModules) {
+        // Opening a module initializes its sensor even when another one is
+        // fitted, so start with the module that was opened last time.
+        const std::string lastVendor = GetProperty("persist.vendor.sys.fp.vendor", "");
+        std::vector<std::string> modules;
+        for (const auto& [module] : kModules) {
+            modules.emplace_back(module);
+        }
+        std::stable_partition(modules.begin(), modules.end(), [&](const std::string& module) {
+            return ::android::base::Split(module, ":")[0] == lastVendor;
+        });
+
+        for (const auto& module : modules) {
             std::string class_name;
             std::string class_module_id;
 
