<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the Xiaomi 15 (dada, SM8750) Evolution X 17 build.

  This is the patch-based variant of dada.xml.  Upstream projects are no
  longer forked: they come from their original owners and are pinned to the
  commits the patches in device/xiaomi/sm8750-common/patches were generated
  against.  After repo sync run:

      source build/envsetup.sh

  device/xiaomi/dada/vendorsetup.sh then applies the patches through
  device/xiaomi/sm8750-common/patches/apply-patches.sh.  To run it manually:

      bash device/xiaomi/sm8750-common/patches/apply-patches.sh \
          device/xiaomi/sm8750-common/patches

  Do not place this file next to dada.xml: repo reads every *.xml in
  .repo/local_manifests and would define the same projects twice.
-->
<manifest>
  <remote name="ilertnost" fetch="https://github.com/ilertnost" />
  <remote name="xiaomi-dada" fetch="https://github.com/xiaomi-dada" revision="lineage-24.0" />
  <remote name="lineage" fetch="https://github.com/LineageOS" />

  <!-- Device tree, common tree and proprietary blobs (device-specific) -->
  <project path="device/xiaomi/dada" name="device_xiaomi_dada" remote="ilertnost" revision="lineage-24.0" />
  <project path="device/xiaomi/sm8750-common" name="device_xiaomi_sm8750-common" remote="ilertnost" revision="lineage-24.0" />
  <project path="vendor/xiaomi/dada" name="vendor_xiaomi_dada" remote="ilertnost" revision="lineage-24.0" />
  <project path="vendor/xiaomi/sm8750-common" name="vendor_xiaomi_sm8750-common" remote="ilertnost" revision="lineage-24.0" />

  <!-- Kernel, built from source (CLO KERNEL.PLATFORM.4.0.r1-18500) -->
  <project path="kernel/xiaomi/sm8750" name="android_kernel_qcom_sm8750" remote="ilertnost" revision="lineage-24.0-oss" />
  <project path="kernel/xiaomi/sm8750-devicetrees" name="android_kernel_xiaomi_sm8750-devicetrees" remote="ilertnost" revision="lineage-24.0" />
  <project path="kernel/xiaomi/sm8750-modules" name="android_kernel_xiaomi_sm8750-modules" remote="ilertnost" revision="lineage-24.0" />

  <!-- hardware/xiaomi: upstream + device/xiaomi/sm8750-common/patches/hardware_xiaomi -->
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" remote="lineage" revision="fb0a2d51c741b4a6af3acc76a337aa4f3d7f9977" />

  <!--
      Display stack: upstream, pinned to the patch base.
      The CAF copies of display/core and display/intf are dropped; the same
      modules come from the open-source sdm/sde-drm and display-intf projects
      checked out under vendor/qcom/opensource.
  -->
  <remove-project name="LineageOS/android_hardware_qcom_display"
                  path="hardware/qcom-caf/sm8750/display/hal" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-core"
                  path="hardware/qcom-caf/sm8750/display/core" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-intf"
                  path="hardware/qcom-caf/sm8750/display/intf" />

  <project path="hardware/qcom-caf/sm8750/display"
           name="android_hardware_qcom_display"
           remote="lineage"
           revision="5b970807ee568f53d8c9c17dae1202059c9fafc3" />
  <project path="vendor/qcom/opensource/display-core"
           name="android_vendor_qcom_opensource_display-core"
           remote="lineage"
           revision="89aa1914da50aae0fb1b2ebf3db38d34fba5f748" />
  <project path="vendor/qcom/opensource/display-intf"
           name="android_vendor_qcom_opensource_display-intf"
           remote="lineage"
           revision="19b5c055b40bc3d7af4309662eea98c7e7a72cee" />

  <!-- Camera fixes: upstream + patches/frameworks_av, frameworks_native -->
  <remove-project name="frameworks_av" path="frameworks/av" />
  <project path="frameworks/av"
           name="frameworks_av"
           remote="evo"
           revision="80917b1522f1eb87b9d8d2bdc143d17b9e9d787b"
           groups="pdk,sysui-studio" />

  <remove-project name="frameworks_native" path="frameworks/native" />
  <project path="frameworks/native"
           name="frameworks_native"
           remote="evo"
           revision="8c23b549b27c7e4ab99bb8cf5a528ee61d8257f2"
           groups="pdk,sysui-studio" />

  <!-- Trusted VM (qcrosvm): upstream + Android.bp visibility patches -->
  <remove-project name="platform/external/crosvm" path="external/crosvm" />
  <remove-project name="platform/external/rust/rutabaga_gfx" path="external/rust/rutabaga_gfx" />
  <remove-project name="platform/packages/modules/Virtualization" path="packages/modules/Virtualization" />

  <project path="external/crosvm"
           name="platform/external/crosvm"
           remote="aosp"
           revision="c7dd8d6950912fa5e6fde7ec2d1616e0ddc090f8"
           groups="pdk" />
  <project path="external/rust/rutabaga_gfx"
           name="platform/external/rust/rutabaga_gfx"
           remote="aosp"
           revision="1f181b0b3e4b821459f21fd9025cd4c408c4f9ec"
           groups="pdk" />
  <project path="packages/modules/Virtualization"
           name="platform/packages/modules/Virtualization"
           remote="aosp"
           revision="22f1c9ee92b146e10c8f5e71338618f77ab1631e"
           groups="pdk" />
  <project path="vendor/qcom/opensource/crosvm-gunyah"
           name="android_vendor_qcom_opensource_crosvm-gunyah"
           remote="xiaomi-dada" />

  <!--
      Dolby Atmos: stays a fork because it carries HyperOS blobs.
      Its patches are kept under
      device/xiaomi/sm8750-common/patches/_forked-blob-repos/hardware/dolby/
      as a backup and are not applied by apply-patches.sh.
  -->
  <project path="hardware/dolby"
           name="android_hardware_dolby"
           remote="ilertnost"
           revision="lineage-24.0" />

  <!--
      Bluetooth and vendor/qcom/opensource/interfaces are stock upstream
      projects pinned to the commits their patches were generated against.
      Their local changes are in device/xiaomi/sm8750-common/patches:
        packages_modules_Bluetooth/
        vendor_qcom_opensource_interfaces/
  -->
  <remove-project name="packages_modules_Bluetooth" path="packages/modules/Bluetooth" />
  <project path="packages/modules/Bluetooth"
           name="packages_modules_Bluetooth"
           remote="evo"
           revision="00f2fc113148277f1cf976d1df07fd28a00001a2"
           groups="pdk" />

  <remove-project name="LineageOS/android_vendor_qcom_opensource_interfaces"
                  path="vendor/qcom/opensource/interfaces" />
  <project path="vendor/qcom/opensource/interfaces"
           name="android_vendor_qcom_opensource_interfaces"
           remote="lineage"
           revision="b75ec20e94b35e067f3af67e628df294b49505d0"
           groups="qcom,qssi" />
</manifest>
