From b8b50e4aca75227553b010820c35483dbb3ac449 Mon Sep 17 00:00:00 2001
From: ilertnost <ilamoiseev757@gmail.com>
Date: Sun, 22 Nov 2026 20:37:00 +0300
Subject: [PATCH] sde-drm: Prefer DDIC 1Hz auto mode and drop sub-60Hz discrete
 modes

On Xiaomi LTPO panels exposing @120x1auto modes, select the hardware
DDIC 1-120Hz auto mode for 120Hz and hide normal 120Hz, test/idle
variants, and discrete 24/30/40Hz modes that stall mode switching.
---
 sde-drm/drm_connector.cpp | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/sde-drm/drm_connector.cpp b/sde-drm/drm_connector.cpp
index 422d4e1..47ef772 100644
--- a/sde-drm/drm_connector.cpp
+++ b/sde-drm/drm_connector.cpp
@@ -1130,6 +1130,42 @@ int DRMConnector::GetInfo(DRMConnectorInfo *info) {
 
   drmModeFreeObjectProperties(props);
 
+  bool has_ddic_auto_1hz = false;
+  bool had_preferred_120 = false;
+  for (const auto &item : info->modes) {
+    const std::string name(item.mode.name);
+    if (name.find("x1auto") != std::string::npos) {
+      has_ddic_auto_1hz = true;
+    }
+    if (item.mode.vrefresh == 120 && (item.mode.type & DRM_MODE_TYPE_PREFERRED)) {
+      had_preferred_120 = true;
+    }
+  }
+
+  if (has_ddic_auto_1hz) {
+    std::vector<DRMModeInfo> filtered_modes;
+    filtered_modes.reserve(info->modes.size());
+    for (auto &item : info->modes) {
+      const std::string name(item.mode.name);
+      if (name.find("@") != std::string::npos) {
+        if (name.find("x1auto") == std::string::npos) {
+          continue;
+        }
+        if (had_preferred_120) {
+          item.mode.type |= DRM_MODE_TYPE_PREFERRED;
+        }
+      } else {
+        if (item.mode.vrefresh == 120 || item.mode.vrefresh < 60) {
+          continue;
+        }
+      }
+      filtered_modes.push_back(item);
+    }
+    if (!filtered_modes.empty()) {
+      info->modes = std::move(filtered_modes);
+    }
+  }
+
   return 0;
 }
 
