From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iscle <albertiscle9@gmail.com>
Date: Wed, 11 Nov 2026 17:09:00 +0100
Subject: [PATCH 1/3] sdmclient: Implement GetDisplayAttributesForConfig

Resolve the display like GetConfigCount() does and return the
attributes of the hardware config.

Change-Id: I9d29205144ce7756873527fd80a523fd8af86fd0
---
 sdmclient/concurrency_mgr.cpp | 11 +++++++++++
 sdmclient/concurrency_mgr.h   |  2 ++
 2 files changed, 13 insertions(+)

diff --git a/sdmclient/concurrency_mgr.cpp b/sdmclient/concurrency_mgr.cpp
index 967e8e7..2c0428d 100644
--- a/sdmclient/concurrency_mgr.cpp
+++ b/sdmclient/concurrency_mgr.cpp
@@ -2129,6 +2129,17 @@ DisplayError ConcurrencyMgr::GetConfigCount(uint64_t disp_id, uint32_t *count) {
   return services_->GetConfigCount(disp_id, count);
 }
 
+DisplayError ConcurrencyMgr::GetDisplayAttributesForConfig(
+    uint64_t disp_id, int32_t config, DisplayConfigVariableInfo *attributes) {
+  int disp_idx = disp_->GetDisplayIndex(INT(disp_id));
+  if (disp_idx == -1 || config < 0 || !attributes) {
+    return kErrorNotSupported;
+  }
+
+  return CallDisplayFunction(disp_idx, &SDMDisplay::GetDisplayAttributesForConfig, config,
+                             attributes);
+}
+
 DisplayError ConcurrencyMgr::GetActiveConfigIndex(uint64_t disp_id,
                                                   uint32_t *config) {
   return services_->GetActiveConfigIndex(disp_id, config);
diff --git a/sdmclient/concurrency_mgr.h b/sdmclient/concurrency_mgr.h
index 891ac23..eb515ed 100644
--- a/sdmclient/concurrency_mgr.h
+++ b/sdmclient/concurrency_mgr.h
@@ -576,6 +576,8 @@ private:
   void SendRefresh(Display display);
 
   DisplayError GetConfigCount(uint64_t disp_id, uint32_t *count);
+  DisplayError GetDisplayAttributesForConfig(
+      uint64_t disp_id, int32_t config, DisplayConfigVariableInfo *attributes);
   DisplayError GetActiveConfigIndex(uint64_t disp_id, uint32_t *config);
   DisplayError SetActiveConfigIndex(uint64_t disp_id, uint32_t config);
   DisplayError SetNoisePlugInOverride(uint64_t disp_id, bool override_en,
