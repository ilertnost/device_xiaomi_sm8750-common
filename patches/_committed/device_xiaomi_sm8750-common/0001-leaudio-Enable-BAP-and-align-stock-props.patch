+# WCN685x firmware crashes with Hardware Error 0x0f after an LE Subrate Request.
+persist.bluetooth.leaudio.subrating_disabled=true
+persist.bluetooth.leaudio.bypass_allow_list=true
+persist.bluetooth.leaudio.allow_list_extend=Xiaomi Buds 5 Pro
+# Disable LE Audio connection subrating: the WCN785x firmware aborts with
+# "Hardware Error Event with code 0x0f" when the host sends a subrate request.
+# min > max makes the stack reject the request before it reaches the controller.
+bluetooth.ble.client.subrate_le_audio_mode_max_subrate.config=0
+bluetooth.ble.client.subrate_le_audio_mode_min_subrate.config=1
 persist.sys.fflag.override.settings_bluetooth_hearing_aid=true
 persist.vendor.qcom.bluetooth.aac_vbr_ctl.enabled=true
