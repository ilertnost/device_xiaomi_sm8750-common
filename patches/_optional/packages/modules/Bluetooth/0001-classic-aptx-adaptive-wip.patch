+  btav_a2dp_codec_bits_per_sample_t bits_per_sample;
+  uint8_t reserved_data[A2DP_APTX_ADAPTIVE_RESERVED_DATA];  // reserved for future exp
+} tA2DP_APTX_ADAPTIVE_CIE;
