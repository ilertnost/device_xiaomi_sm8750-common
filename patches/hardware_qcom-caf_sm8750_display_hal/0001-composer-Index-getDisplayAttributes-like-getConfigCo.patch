From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iscle <albertiscle9@gmail.com>
Date: Wed, 11 Nov 2026 17:09:00 +0100
Subject: [PATCH 1/3] composer: Index getDisplayAttributes like getConfigCount

IDisplayConfig clients iterate getDisplayAttributes() from 0 to
getConfigCount() - 1, but it looked the index up in the client config
map, which skips modes with identical attributes. On panels that report
such modes (e.g. Xiaomi's 120 Hz idle variants), every index past the
first duplicate failed.

Change-Id: I4766982180f8ed759c8d9c23378a3ac88e57c9e7
---
 composer/DisplayConfigAIDL.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/composer/DisplayConfigAIDL.cpp b/composer/DisplayConfigAIDL.cpp
index 3db51c0d..f77b1610 100644
--- a/composer/DisplayConfigAIDL.cpp
+++ b/composer/DisplayConfigAIDL.cpp
@@ -209,11 +209,13 @@ ScopedAStatus DisplayConfigAIDL::getDisplayAttributes(int config_index, DisplayT
   auto error = sdm::kErrorNone;
   int disp_id = MapDisplayType(dpy);
 
+  // The index space is the one of getConfigCount(), which counts every mode
+  // the panel reports, not only the configurations exposed to the client.
   sdm::DisplayConfigVariableInfo var_info{};
-  error = settings_->GetDisplayAttributes(disp_id, config_index, &var_info);
+  error = lifecycle_->GetDisplayAttributesForConfig(disp_id, config_index, &var_info);
 
   if (error != sdm::kErrorNone) {
-    ALOGW("%s: Invalid display = %d", __FUNCTION__, disp_id);
+    ALOGW("%s: Invalid display = %d or config = %d", __FUNCTION__, disp_id, config_index);
     return ScopedAStatus(AStatus_fromExceptionCode(EX_ILLEGAL_ARGUMENT));
   }
 
