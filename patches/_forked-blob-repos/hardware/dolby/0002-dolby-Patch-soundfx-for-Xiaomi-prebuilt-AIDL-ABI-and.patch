 .../lib64/soundfx/libswspatializeraidl.so     |  Bin 2907344 -> 3137929 bytes
 7 files changed, 1166 insertions(+), 755 deletions(-)

diff --git a/dolby.mk b/dolby.mk
index 237590c..44746a2 100644
--- a/dolby.mk
+++ b/dolby.mk
@@ -108,10 +108,6 @@ PRODUCT_SYSTEM_EXT_PROPERTIES += \
     ro.audio.spatializer_transaural_enabled_default=false \
     ro.audio.stereo_spatialization_enabled=true
 
-# Stock HyperOS 4 AIDL/DMS dependencies required by libhwdapaidl.so
-PRODUCT_COPY_FILES += \
-    $(DOLBY_PATH)/proprietary/vendor/lib64/libdmshal.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libdmshal.so \
-    $(DOLBY_PATH)/proprietary/vendor/lib64/libspatializerparamstorage.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libspatializerparamstorage.so \
-    $(DOLBY_PATH)/proprietary/vendor/lib64/libaudio_aidl_conversion_common_ndk.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libaudio_aidl_conversion_common_ndk.so \
-    $(DOLBY_PATH)/proprietary/vendor/lib64/android.media.audio.common.types-V6-ndk.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.media.audio.common.types-V6-ndk.so \
-    $(DOLBY_PATH)/proprietary/vendor/lib64/android.hardware.audio.common-V3-ndk.so:$(TARGET_COPY_OUT_VENDOR)/lib64/android.hardware.audio.common-V3-ndk.so
+# Stock HyperOS 4 spatializer storage dependency required by libhwdapaidl.so
+PRODUCT_PACKAGES += \
+    libspatializerparamstorage
