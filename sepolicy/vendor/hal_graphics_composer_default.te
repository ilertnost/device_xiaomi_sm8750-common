# Request a screen writeback for the light sensor after every frame
hal_client_domain(hal_graphics_composer_default, hal_citsensorservice_xiaomi)

allow hal_graphics_composer_default vendor_miclstc_service:service_manager find;
binder_call(hal_graphics_composer_default, displayfeature)

add_service(hal_graphics_composer_default, vendor_miclstc_service)
