# The prebuilt PAL reports active capture to the wireless charger through the
# Xiaomi charging service, and fails to open the device without it
hal_client_domain(hal_audio_default, hal_micharge_xiaomi)

get_prop(hal_audio_default, audio_config_prop)
get_prop(hal_audio_default, bluetooth_config_prop)
set_prop(hal_audio_default, vendor_audio_runtime_prop)
