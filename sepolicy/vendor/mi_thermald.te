type mi_thermald, domain;
type mi_thermald_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mi_thermald)

dontaudit mi_thermald self:capability { dac_override dac_read_search };

r_dir_file(mi_thermald, vendor_sysfs_displayfeature)
r_dir_file(mi_thermald, vendor_sysfs_graphics)

allow mi_thermald thermal_data_file:dir rw_dir_perms;
allow mi_thermald thermal_data_file:file create_file_perms;
allow mi_thermald sysfs:dir r_dir_perms;

allow mi_thermald sysfs_thermal:file rw_file_perms;
allow mi_thermald vendor_sysfs_xm_power:dir r_dir_perms;
allow mi_thermald vendor_sysfs_xm_power:file rw_file_perms;
set_prop(mi_thermald, vendor_default_prop)
