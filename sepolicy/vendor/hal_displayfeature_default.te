type hal_displayfeature_default, domain;
hal_server_domain(hal_displayfeature_default, hal_displayfeature)

type hal_displayfeature_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_displayfeature_default)

vndbinder_use(hal_displayfeature_default)

hal_client_domain(hal_displayfeature_default, hal_graphics_allocator)
hal_client_domain(hal_displayfeature_default, hal_graphics_composer)
hal_client_domain(hal_displayfeature_default, hal_sensors)

binder_call(hal_displayfeature_default, surfaceflinger)
binder_call(hal_displayfeature_default, system_server)
allow hal_displayfeature_default fwk_sensor_service:service_manager find;
allow hal_displayfeature_default surfaceflinger_service:service_manager find;

allow hal_displayfeature_default vendor_displayfeature_device:chr_file rw_file_perms;
allow hal_displayfeature_default vendor_sysfs_displayfeature:dir r_dir_perms;
allow hal_displayfeature_default vendor_sysfs_displayfeature:file rw_file_perms;
allow hal_displayfeature_default vendor_sysfs_displayfeature:lnk_file r_file_perms;

allow hal_displayfeature_default sysfs:dir search;
allow hal_displayfeature_default sysfs:file r_file_perms;
allow hal_displayfeature_default sysfs_leds:dir r_dir_perms;
allow hal_displayfeature_default sysfs_leds:file rw_file_perms;
allow hal_displayfeature_default sysfs_leds:lnk_file r_file_perms;
r_dir_file(hal_displayfeature_default, sysfs_thermal)

allow hal_displayfeature_default mnt_vendor_file:dir search;
set_prop(hal_displayfeature_default, vendor_displayfeature_prop)
set_prop(hal_displayfeature_default, vendor_display_prop)

add_service(hal_displayfeature_default, hal_framecapturemanager_service)
allow hal_displayfeature_default vendor_display_vendor_data_file:dir create_dir_perms;
allow hal_displayfeature_default vendor_display_vendor_data_file:file create_file_perms;
r_dir_file(hal_displayfeature_default, vendor_persist_display_file)
