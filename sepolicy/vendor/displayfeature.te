type displayfeature, domain;
type displayfeature_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(displayfeature)

binder_use(displayfeature)
vndbinder_use(displayfeature)

hal_client_domain(displayfeature, hal_displayfeature)
hal_client_domain(displayfeature, hal_graphics_allocator)
hal_client_domain(displayfeature, hal_graphics_composer)
hal_client_domain(displayfeature, hal_sensors)

binder_call(displayfeature, surfaceflinger)
binder_call(displayfeature, system_server)
allow displayfeature fwk_sensor_service:service_manager find;
allow displayfeature surfaceflinger_service:service_manager find;

dontaudit displayfeature self:capability { dac_override dac_read_search sys_nice };
allow displayfeature self:capability sys_nice;

allow displayfeature vendor_displayfeature_device:chr_file rw_file_perms;
allow displayfeature vendor_sysfs_displayfeature:dir r_dir_perms;
allow displayfeature vendor_sysfs_displayfeature:file rw_file_perms;
allow displayfeature vendor_sysfs_displayfeature:lnk_file r_file_perms;

allow displayfeature sysfs:dir search;
allow displayfeature sysfs:file r_file_perms;
allow displayfeature sysfs_leds:dir r_dir_perms;
allow displayfeature sysfs_leds:file rw_file_perms;
allow displayfeature sysfs_leds:lnk_file r_file_perms;
r_dir_file(displayfeature, sysfs_thermal)

allow displayfeature mnt_vendor_file:dir search;
set_prop(displayfeature, vendor_displayfeature_prop)
set_prop(displayfeature, vendor_display_prop)

allow displayfeature hal_framecapturemanager_service:service_manager find;
allow displayfeature vendor_display_vendor_data_file:dir create_dir_perms;
allow displayfeature vendor_display_vendor_data_file:file create_file_perms;
r_dir_file(displayfeature, vendor_persist_display_file)

add_service(displayfeature, vendor_displayfeature_control_service)
allow displayfeature hal_framecapturemanager_service:service_manager find;
allow displayfeature vendor_display_vendor_data_file:dir create_dir_perms;
allow displayfeature vendor_display_vendor_data_file:file create_file_perms;
r_dir_file(displayfeature, vendor_persist_display_file)
